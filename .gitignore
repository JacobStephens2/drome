# Rust (Cargo.lock stays committed for reproducible builds)
core/target/

# Apple / Xcode
ios/Frameworks/DromeCore.xcframework/
ios/Frameworks/*.a
ios/DromeShared/Generated/*.h
ios/DromeShared/Generated/*.modulemap
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# macOS
.DS_Store

# Scratch
*.log
.scratch/
ios/Frameworks/**/*.a

# OpenTofu / infra (never commit state, downloaded plugins, real tfvars, or
# backend creds; .terraform.lock.hcl IS committed for reproducible provider pins)
infra/.terraform/
*.tfstate
*.tfstate.*
infra/terraform.tfvars
infra/*.auto.tfvars
infra/backend.hcl
tfplan
crash.log

# Deploy: the rendered .env is generated at deploy time from secrets
deploy/.env
