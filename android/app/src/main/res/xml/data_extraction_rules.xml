<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="drome.sqlite" />
        <exclude domain="file" path="drome.sqlite-wal" />
        <exclude domain="file" path="drome.sqlite-shm" />
        <exclude domain="file" path="photos/" />
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="drome.sqlite" />
        <exclude domain="file" path="drome.sqlite-wal" />
        <exclude domain="file" path="drome.sqlite-shm" />
        <exclude domain="file" path="photos/" />
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
