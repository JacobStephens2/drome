# Template for the runtime .env. deploy.sh WRITES the real .env on the droplet
# from the GitHub `deploy` environment secrets — this file documents the shape.
# PLACEHOLDERS ONLY; never commit real secrets.

# ---- Image (GitOps) ----
# deploy.sh sets this to the fully-qualified GHCR reference pinned to the git
# SHA that CI just built. NEVER :latest. (A digest form,
# ghcr.io/<owner>/drome-server@sha256:..., is even stronger.)
IMAGE_TAG=ghcr.io/jacobstephens2/drome-server:REPLACE_WITH_GIT_SHA

# ---- Server ----
BETA_ALL_ENTITLED=true
# DROME_BIND / DROME_DB are set in compose.yml (container-internal paths).
# DROME_DEV_AUTH: NEVER set in production — leave it entirely unset so the
# /v1/auth/dev route is not even mounted (docs/PHASE2.md).

# ---- Email OTP sign-in (Resend) ----
# Optional. Leave RESEND_API_KEY empty and the server LOGS codes instead of
# emailing them (email sign-in inert). RESEND_FROM must be a verified sender on
# the Resend account (verify drome.day via SPF/DKIM DNS on Cloudflare).
RESEND_API_KEY=
RESEND_FROM=Drome <login@drome.day>

# ---- Data volume mount (matches infra cloud-init data_mount_path) ----
DATA_DIR=/mnt/drome-data

# ---- Caddy / TLS ----
DROME_DOMAIN=drome.day
ACME_EMAIL=ops@drome.day

# ---- Litestream → R2 (litestream bucket + its scoped token) ----
# From tofu outputs: r2_litestream_bucket, litestream_r2_access_key_id,
# litestream_r2_secret_access_key ( = sha256(token value) ).
LITESTREAM_R2_ENDPOINT=https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_R2_BUCKET=drome-litestream
LITESTREAM_R2_ACCESS_KEY_ID=REPLACE_ME_r2_token_access_key_id
LITESTREAM_R2_SECRET_ACCESS_KEY=REPLACE_ME_sha256_of_token_value
