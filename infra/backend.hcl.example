# EXAMPLE ONLY — copy to backend.hcl (gitignored) and pass at init:
#   tofu init -backend-config=backend.hcl
#
# These are the values backend.tf leaves out (a backend block can't read
# variables). The state bucket + token are HAND-BOOTSTRAPPED first (README.md);
# they are never managed by this stack.

bucket = "drome-tofu-state"
key    = "drome/prod/terraform.tfstate"

endpoints = {
  s3 = "https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com"
}

# Credentials for the R2 state token. Prefer the standard env vars instead of
# putting these here:
#   export AWS_ACCESS_KEY_ID=<r2 state token access key id>
#   export AWS_SECRET_ACCESS_KEY=<sha256(r2 state token value)>
# access_key = "REPLACE_ME"
# secret_key = "REPLACE_ME"
