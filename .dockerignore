# Build context is the repo root (server/Dockerfile needs ../core). Keep out
# everything the server build doesn't need — especially the host's macOS/iOS
# build artifacts (wrong arch, huge).

.git
.github
.gitignore

# iOS / Xcode — irrelevant to the server image
ios
DerivedData
**/*.xcodeproj
**/*.xcworkspace

# Rust build outputs (the container rebuilds for musl from scratch)
core/target
target

# Infra / deploy / docs / research — not part of the server build
infra
deploy
docs
research
*.md
**/*.md

# Local secrets / scratch / OS cruft
**/.env
**/*.tfvars
**/.terraform
.scratch
*.log
.DS_Store
**/.DS_Store
